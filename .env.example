APP_NAME=Online Lerncampus
APP_ENV=local
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONTENT_REVIEW_REQUIRED=true
CONTENT_SOURCE=db
CONTENT_SEED_ON_STARTUP=true
CONTENT_SEED_FORMAT=python
CONTENT_JSON_BUNDLE_PATH=app/content/maf/v1/bundle.json
AI_PROVIDER=disabled
DATABASE_URL=sqlite:///./local.db
# Production: DATABASE_URL=postgresql://user:pass@localhost:5432/lerncampus
APP_SECRET=change-this-before-production
# Production: APP_ENV != local erzwingt ein starkes APP_SECRET (>= 32 Zeichen)
# und APP_DEBUG=false.
SESSION_TTL_HOURS=12
# Erster Plattform-Admin wird beim Start einmalig angelegt, wenn beide Werte
# gesetzt sind. Staff-Rollen gibt es nur noch ueber die Admin-API.
# BOOTSTRAP_ADMIN_IDENTIFIER=admin@example.org
# BOOTSTRAP_ADMIN_PASSWORD=bitte-sicher-ersetzen
PRIVACY_NOTICE_VERSION=2026-08-12-mvp
